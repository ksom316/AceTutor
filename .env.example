# AceTutor environment configuration.
# Copy this file to `.env` and fill in the values. Do not commit a filled-in `.env`.

# --- Supabase: client (injected into the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server (SSR + server functions) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter: AI Tutor, AI games, lecturer quiz generation ---
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Quiz Me: practice-quiz answer-key encryption ---
# Server-only. The ONLY key material for the AES-GCM token that hides practice
# answers from the browser — no fallback to any other credential. Required for
# "Quiz Me" to work. Use a long random string (>= 16 chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRACTICE_QUIZ_SECRET=

# --- VARK ML inference: live classification from the real trained model ---
# Server-only. VARK_INFERENCE_URL is the deployed Vercel Python inference
# project's endpoint (see ml/vark/service/README.md — a SEPARATE, small
# Vercel project, not this app's own deployment). VARK_INFERENCE_SECRET must
# match the same value set on that project; sent as the X-Inference-Secret
# header on every call. Without these, VARK ML classification is skipped
# (the questionnaire-derived tendency still saves and works normally).
VARK_INFERENCE_URL=
VARK_INFERENCE_SECRET=

# --- YouTube Data API v3: remedial video recommendations (R6) ---
# Server-only (never prefix with VITE_). Used ONLY when no relevant course
# video exists, to fetch a small set of REAL YouTube search results for the
# Study Path's weak concepts. Without it, AceTutor falls back to course videos
# and otherwise shows no video card — text/audio/visual remediation is
# unaffected. Create a key at https://console.cloud.google.com/apis/credentials
# and enable "YouTube Data API v3". Requests are capped at 5 results to
# conserve the default 10,000 units/day quota.
YOUTUBE_API_KEY=

# --- OpenRouter: model roster (optional — code has working defaults) ---
# Sequential fallback, primary -> secondary -> emergency. The code defaults in
# src/lib/course-chat.functions.ts are the paid roster below (verified against
# https://openrouter.ai/api/v1/models on 2026-09-08); set OPENROUTER_MODELS to
# override the whole list, or the per-slot vars to override one slot.
# OPENROUTER_MODELS="anthropic/claude-sonnet-5,openai/gpt-4.1,google/gemini-2.5-flash"
# OPENROUTER_MODEL_GEMINI=   # slot 1 (primary)
# OPENROUTER_MODEL_GPT=      # slot 2 (secondary)
# OPENROUTER_MODEL=          # slot 3 (emergency)
# OPENROUTER_SITE_URL=
