# AceTutor environment configuration.
# Copy this file to `.env` and fill in the values. Do not commit a filled-in `.env`.

# --- Supabase: client (injected into the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase: server (SSR + server functions) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter: AI Tutor, AI games, lecturer quiz generation ---
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Quiz Me: practice-quiz answer-key encryption ---
# Server-only. The ONLY key material for the AES-GCM token that hides practice
# answers from the browser — no fallback to any other credential. Required for
# "Quiz Me" to work. Use a long random string (>= 16 chars), e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PRACTICE_QUIZ_SECRET=

# --- VARK ML inference: live classification from the real trained model ---
# Server-only. VARK_INFERENCE_URL is the deployed Vercel Python inference
# project's endpoint (see ml/vark/service/README.md — a SEPARATE, small
# Vercel project, not this app's own deployment). VARK_INFERENCE_SECRET must
# match the same value set on that project; sent as the X-Inference-Secret
# header on every call. Without these, VARK ML classification is skipped
# (the questionnaire-derived tendency still saves and works normally).
VARK_INFERENCE_URL=
VARK_INFERENCE_SECRET=

# --- OpenRouter: model roster (optional — code has working defaults) ---
# OPENROUTER_MODELS=
# OPENROUTER_MODEL_GEMINI=
# OPENROUTER_MODEL_GPT=
# OPENROUTER_MODEL=
# OPENROUTER_SITE_URL=
